Screen {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
}
#input-grid {
    grid-size: 2;
    grid-rows: 1fr 1fr 2fr;
    grid-gutter: 1;
}
#input-grid VerticalGroup{
    height: 1fr;
    align: left bottom;
}
#input-grid Button {
    width: 1fr;
    height: 1fr;
    margin: 0 1 0 1;
}
#right-div OptionList {
    height: 1fr;
    margin: 1 0 1 0;
}
#result {
    height: 1fr;
    width: 1fr;
    background: $surface-lighten-1;
    column-span: 2;
    border: tall $border-blurred;
    margin: 0 0 1 0;
    padding: 0 1 0 1;
}